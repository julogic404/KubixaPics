<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KubixaPics" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde_marca</item>
        <item name="colorOnPrimary">@color/sobre_marca</item>
        <item name="colorPrimaryContainer">@color/verde_marca_contentor</item>
        <item name="colorOnPrimaryContainer">@color/texto_primario</item>
        <item name="colorSecondary">@color/verde_marca_escuro</item>
        <item name="colorSurface">@color/superficie_cartao</item>
        <item name="colorOnSurface">@color/texto_primario</item>
        <item name="colorSurfaceVariant">@color/superficie_rebaixada</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno_suave</item>
        <item name="colorError">@color/erro</item>
        <item name="android:colorBackground">@color/superficie_base</item>
        <item name="colorOnBackground">@color/texto_primario</item>

        <item name="android:windowBackground">@color/superficie_base</item>
        <item name="android:statusBarColor">@color/superficie_base</item>
        <item name="android:navigationBarColor">@color/superficie_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="Widget.KubixaPics.BarraFerramentas" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/transparente</item>
        <item name="titleTextColor">@color/texto_primario</item>
        <item name="navigationIconTint">@color/texto_primario</item>
        <item name="titleCentered">false</item>
    </style>

    <style name="TextAppearance.KubixaPics.TituloSecao" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.KubixaPics.Corpo" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.KubixaPics.Botao.Primario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/verde_marca</item>
        <item name="android:textColor">@color/sobre_marca</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.KubixaPics.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/verde_marca</item>
        <item name="hintTextColor">@color/texto_suave</item>
    </style>

    <style name="Widget.KubixaPics.Botao.Contornado" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/contorno_suave</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
