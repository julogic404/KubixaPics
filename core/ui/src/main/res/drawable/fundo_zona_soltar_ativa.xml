<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/verde_marca_contentor">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie_rebaixada" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:dashWidth="9dp"
                android:dashGap="5dp"
                android:color="@color/verde_marca" />
        </shape>
    </item>
</ripple>
