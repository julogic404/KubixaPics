<!-- Cartao escuro com contorno verde e brilho suave (secao Desenvolvedor). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brilho exterior -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="4dp"
                android:color="@color/dev_cartao_brilho" />
        </shape>
    </item>
    <!-- Corpo + contorno nitido -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dev_cartao_fundo" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/dev_cartao_borda" />
        </shape>
    </item>
</layer-list>
