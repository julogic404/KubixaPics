<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraFerramentas"
        style="@style/Widget.KubixaPics.BarraFerramentas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_barra_ferramentas"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_seta_voltar"
        app:title="@string/sobre_titulo" />

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/padding_ecra"
        android:paddingEnd="@dimen/padding_ecra"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraFerramentas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Formatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_formatos_titulo"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/sobre_formatos_entrada"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sobre_formatos_saida"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo" />
            </LinearLayout>

            <!-- Recursos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_recursos_titulo"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_offline"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_privacidade"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_lote"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_qualidade"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_exif"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_transparencia"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />
            </LinearLayout>

            <!-- Desenvolvedor: cartao escuro com contorno verde, nome + utilizador + link e logo do GitHub -->
            <LinearLayout
                android:id="@+id/cartaoDesenvolvedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao_desenvolvedor"
                android:clickable="true"
                android:contentDescription="@string/sobre_desenvolvedor_link_desc"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sobre_desenvolvedor_nome"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/sobre_desenvolvedor_usuario"
                        android:textColor="@color/dev_texto_suave"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGithub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.04"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/sobre_desenvolvedor_link"
                        android:textColor="@color/dev_link"
                        android:textSize="17sp" />
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/fundo_divisor_verde" />

                <LinearLayout
                    android:layout_width="108dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_github" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/sobre_github_rotulo"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
