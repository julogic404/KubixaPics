<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie_base">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraFerramentas"
        style="@style/Widget.KubixaPics.BarraFerramentas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_barra_ferramentas"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_seta_voltar"
        app:title="@string/sobre_titulo" />

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/padding_ecra"
        android:paddingEnd="@dimen/padding_ecra"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraFerramentas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Formatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_formatos_titulo"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/sobre_formatos_entrada"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sobre_formatos_saida"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo" />
            </LinearLayout>

            <!-- Recursos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_recursos_titulo"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_offline"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_privacidade"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_lote"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_qualidade"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_exif"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:text="@string/recurso_transparencia"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    app:drawableStartCompat="@drawable/ic_verificar_circulo"
                    app:drawableTint="@color/sucesso" />
            </LinearLayout>

            <!-- Desenvolvedor: apenas nome + hiperligacao para o portfolio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_desenvolvedor_nome"
                    android:textColor="@color/texto_primario"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGithub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/sobre_desenvolvedor_link_desc"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/sobre_desenvolvedor_link"
                    android:textColor="@color/verde_marca"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
