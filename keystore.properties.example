# Copie este ficheiro para 'keystore.properties' e preencha com os seus dados.
# NUNCA faca commit do keystore.properties nem do ficheiro .jks num repositorio publico.
#
# Gerar um keystore novo (validade ~27 anos, RSA 4096):
#   keytool -genkeypair -v -keystore kubixapics-release.jks -alias kubixapics \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile e relativo a raiz do projeto (ou um caminho absoluto).
storeFile=kubixapics-release.jks
storePassword=CHANGE_ME
keyAlias=kubixapics
keyPassword=CHANGE_ME
