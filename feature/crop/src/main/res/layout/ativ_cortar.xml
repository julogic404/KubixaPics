<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie_base">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraFerramentas"
        style="@style/Widget.KubixaPics.BarraFerramentas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_barra_ferramentas"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_seta_voltar"
        app:title="@string/cortar_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/padding_ecra"
        android:paddingEnd="@dimen/padding_ecra"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/barraInferior"
        app:layout_constraintTop_toBottomOf="@id/barraFerramentas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Area de recorte -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/fundo_cartao">

                <ao.julogic404.kubixapics.core.ui.widget.CortarView
                    android:id="@+id/cortarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/dicaVazio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/cortar_sem_imagem"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/barraProgresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/verde_marca"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/cortar_dica"
                android:textColor="@color/texto_suave"
                android:textSize="11sp" />

            <!-- Proporcao -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cortar_proporcao"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoChipsProporcao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRodar"
                        style="@style/Widget.KubixaPics.Botao.Contornado"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/cortar_rodar"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_rodar"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/tvRotacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/cortar_rotacao"
                        android:textColor="@color/texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cartaoEscolher"
                style="@style/Widget.KubixaPics.Botao.Contornado"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/acao_escolher_imagem"
                android:textSize="13sp"
                app:icon="@drawable/ic_galeria_fotos"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/texto_secundario" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acoes FIXA: fica sempre visivel, fora do scroll -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie_base"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/contorno_suave" />

        <LinearLayout
            android:id="@+id/linhaAcoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_ecra"
            android:paddingTop="@dimen/espaco_medio"
            android:paddingEnd="@dimen/padding_ecra"
            android:paddingBottom="@dimen/espaco_medio">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAplicar"
                style="@style/Widget.KubixaPics.Botao.Primario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:enabled="false"
                android:text="@string/acao_aplicar"
                android:textSize="15sp"
                app:icon="@drawable/ic_transferir"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/sobre_marca" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
