<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie_base">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraFerramentas"
        style="@style/Widget.KubixaPics.BarraFerramentas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_barra_ferramentas"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_seta_voltar"
        app:title="@string/comprimir_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/padding_ecra"
        android:paddingEnd="@dimen/padding_ecra"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutAcoes"
        app:layout_constraintTop_toBottomOf="@id/barraFerramentas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Qualidade -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_cartao"
                android:orientation="vertical"
                android:padding="@dimen/padding_cartao">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/qualidade_rotulo"
                        android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao" />

                    <TextView
                        android:id="@+id/tvValorQualidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fundo_selo_sucesso"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="80%"
                        android:textColor="@color/sucesso"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderQualidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="5"
                    android:value="80"
                    android:valueFrom="10"
                    android:valueTo="100"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/verde_marca"
                    app:tickVisible="false"
                    app:trackColorActive="@color/verde_marca"
                    app:trackColorInactive="@color/superficie_rebaixada" />

                <TextView
                    android:id="@+id/tvDicaQualidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qualidade_dica_media"
                    android:textAppearance="@style/TextAppearance.KubixaPics.Corpo"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/alvo_rotulo"
                    android:textAppearance="@style/TextAppearance.KubixaPics.TituloSecao"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoChipsAlvo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true" />
            </LinearLayout>

            <!-- Zona de selecao -->
            <LinearLayout
                android:id="@+id/cartaoZonaSoltar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_zona_soltar"
                android:layout_marginTop="16dp"
                android:background="@drawable/fundo_zona_soltar_ativa"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/zona_soltar_titulo"
                    android:src="@drawable/ic_galeria_fotos"
                    app:tint="@color/verde_marca" />

                <TextView
                    android:id="@+id/tvTituloZonaSoltar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/zona_soltar_titulo"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zona_soltar_subtitulo"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/barraProgresso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/verde_marca"
                    android:max="100"
                    android:progressTint="@color/verde_marca"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Resumo -->
            <LinearLayout
                android:id="@+id/cartaoResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fundo_cartao"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_cartao"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/resumo_titulo"
                    android:src="@drawable/ic_verificar_circulo"
                    app:tint="@color/sucesso" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvResumoContagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResumoPoupado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/sucesso"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/estadoVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/estado_vazio_titulo"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/estado_vazio_subtitulo"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Lista -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarMais"
                style="@style/Widget.KubixaPics.Botao.Contornado"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/acao_escolher_mais"
                android:textSize="13sp"
                app:icon="@drawable/ic_adicionar"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/texto_secundario" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acoes FIXA: fica sempre visivel, fora do scroll -->
    <LinearLayout
        android:id="@+id/layoutAcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie_base"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/contorno_suave" />

        <LinearLayout
            android:id="@+id/linhaAcoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_ecra"
            android:paddingTop="@dimen/espaco_medio"
            android:paddingEnd="@dimen/padding_ecra"
            android:paddingBottom="@dimen/espaco_medio">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLimparTudo"
                    style="@style/Widget.KubixaPics.Botao.Contornado"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/acao_limpar_tudo"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_apagar"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/texto_secundario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarTodas"
                    style="@style/Widget.KubixaPics.Botao.Primario"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/acao_guardar_todas"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_transferir"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/sobre_marca" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
